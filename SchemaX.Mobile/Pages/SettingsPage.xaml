<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchemaX.Mobile.Pages.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Settings" FontSize="22" FontAttributes="Bold" />
        <Button Text="Sign Out"
                BackgroundColor="{StaticResource SchemaDanger}"
                TextColor="White"
                Clicked="OnSignOutClicked" />
    </VerticalStackLayout>
</ContentPage>
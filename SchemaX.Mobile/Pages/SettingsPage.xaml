<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchemaX.Mobile.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Server / Data Source Status Card -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Data Service &amp; Connection"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SchemaPrimary}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Active Provider:" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="ProviderLabel" Text="Checking..." />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Connection Status:" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="ConnectionStatusLabel" Text="Not tested yet" />
                    </Grid>

                    <Button x:Name="TestConnectionButton"
                            Text="Test Connection (Ping)"
                            BackgroundColor="{StaticResource SchemaAccent}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"
                            Clicked="OnTestConnectionClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- App Info Card -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="About SchemaX Mobile"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SchemaPrimary}" />
                    <Label Text="Student Information System (CAP101)" FontSize="14" />
                    <Label Text="Target Framework: .NET 10 MAUI"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Sign Out Action -->
            <Button Text="Sign Out"
                    BackgroundColor="{StaticResource SchemaDanger}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="46"
                    Clicked="OnSignOutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SchemaX.Mobile.Pages.LoginPage"
             Title="Sign In"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <VerticalStackLayout VerticalOptions="Center" Padding="24" Spacing="16">
        <Label Text="SchemaX SIS"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource SchemaPrimary}"
               HorizontalOptions="Center" />
        <Button Text="Continue to Directory"
                BackgroundColor="{StaticResource SchemaPrimary}"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="48"
                Clicked="OnSignInClicked" />
    </VerticalStackLayout>
</ContentPage>
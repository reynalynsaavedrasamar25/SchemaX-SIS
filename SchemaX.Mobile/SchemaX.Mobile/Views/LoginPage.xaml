<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchemaX.Mobile.ViewModels"
             x:Class="SchemaX.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- Brand -->
            <VerticalStackLayout Spacing="6">
                <Image Source="schemax_logo.png"
                       WidthRequest="96" HeightRequest="96"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="SchemaX logo" />
                <Label Text="SchemaX SIS" FontSize="28" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Sign in to view the student directory"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <!-- Form card -->
            <Border StrokeShape="RoundRectangle 14" StrokeThickness="1" Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                <VerticalStackLayout Spacing="12">
                    <Entry x:Name="UsernameEntry" Placeholder="Username" Text="{Binding Username}"
                            ReturnType="Next" Completed="OnUsernameCompleted" />
                    <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" Text="{Binding Password}"
                            ReturnType="Go" Completed="OnPasswordCompleted" />
                    <Button Text="Log in" Command="{Binding LoginCommand}" Margin="0,8,0,0" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
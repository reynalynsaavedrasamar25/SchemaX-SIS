<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchemaX.Mobile.ViewModels"
             xmlns:models="clr-namespace:SchemaX.SIS.Models"
             x:Class="SchemaX.Mobile.Views.StudentListPage"
             x:DataType="vm:StudentListViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">

    <ContentPage.Resources>
        <!-- One look for every quick-filter btn -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:FilterChip">
            <Grid>
                <!-- Normal (grey) chip, always there -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 19"
                        HeightRequest="38"
                        Padding="16,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                    <Label Text="{Binding Label}" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </Border>

                <!-- Selected (blue) chip, only visible when IsSelected is true -->
                <Border IsVisible="{Binding IsSelected}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 19"
                        HeightRequest="38"
                        Padding="16,0"
                        BackgroundColor="{StaticResource Accent}">
                    <Label Text="{Binding Label}" FontSize="13" VerticalOptions="Center"
                           TextColor="White" />
                </Border>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCommand}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,8" Spacing="2">
            <Label Text="Students" FontSize="28" FontAttributes="Bold" />
            <Label Text="SchemaX Directory"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <!-- Search bar -->
        <SearchBar Grid.Row="1"
                   Placeholder="Search by name or student ID"
                   Text="{Binding SearchText}"
                   Margin="8,0,8,4" />

        <!-- Quick filters -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="0,4,0,8">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" Padding="16,0"
                                       BindableLayout.ItemsSource="{Binding ProgramFilters}"
                                       BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
            </ScrollView>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" Padding="16,0"
                                       BindableLayout.ItemsSource="{Binding YearFilters}"
                                       BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
            </ScrollView>
        </VerticalStackLayout>

        <!-- Student cards -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Students}"
                        SelectionMode="Single"
                        SelectionChanged="OnStudentSelected"
                        Margin="16,0,16,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding FullName}"
                                       FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding StudentId}" FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding Bloc, StringFormat='Bloc {0}'}" FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,4"
                                        BackgroundColor="{StaticResource Accent}">
                                    <Label Text="{Binding Program}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="White" />
                                </Border>
                                <Label Text="{Binding YearLevel, StringFormat='Year {0}'}"
                                       FontSize="13" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Status msg and spinner drawn on top of list area -->
        <Label Grid.Row="3" Text="{Binding StatusMessage}"
               HorizontalOptions="Center" VerticalOptions="Center" />
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
    <rich_text scale="h1">DATABASE INFORMATION</rich_text>
    <rich_text>
</rich_text>
    <rich_text weight="heavy">Team SchemaX | Student Information System</rich_text>
    <rich_text>
</rich_text>
    <rich_text weight="heavy">Project Version:</rich_text>
    <rich_text> 1.0
</rich_text>
    <rich_text weight="heavy">Database:</rich_text>
    <rich_text> schemax_sis
</rich_text>
    <rich_text weight="heavy">Last Updated:</rich_text>
